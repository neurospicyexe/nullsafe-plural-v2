{
        "$schema": "node_modules/wrangler/config-schema.json",
        "name": "nullsafe-plural-v2",
        "main": "src/index.ts",
        "compatibility_date": "2025-03-10",
        "compatibility_flags": [
                "nodejs_compat"
        ],
        "migrations": [
    {
        "new_sqlite_classes": [
            "NullsafePluralMCP"
        ],
        "tag": "v3"
    }
        ],
        "durable_objects": {
                "bindings": [
                        {
                                "class_name": "NullsafePluralMCP",
                                "name": "MCP_OBJECT"
                        }
                ]
        },
        "kv_namespaces": [
                {
                        "binding": "OAUTH_KV",
                        "id": "REPLACE_WITH_KV_NAMESPACE_ID"
                }
        ],
        "observability": {
                "enabled": true
        }
}